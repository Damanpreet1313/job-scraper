# SQLite by default. Swap for Postgres (e.g. Supabase/Render) when you move this to a scheduled job:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./jobs.db

# Minimum cosine similarity (0-1) for a job to be flagged as "matched" against resume.txt
MATCH_THRESHOLD=0.15

# Optional: set a Groq API key (console.groq.com) to upgrade matching from
# pure TF-IDF to TF-IDF prefilter + Groq semantic score with a match_reason.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# How many days a job stays in the DB / matches.txt before being purged.
# MATCH_RETENTION_DAYS=3

# Adzuna API (developer.adzuna.com — free account). Covers India ("in")
# listings, where many DevOps internships live. Unset keys skip the source.
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# ADZUNA_REGION=in
