# SQLite by default. Swap for Postgres (e.g. Supabase/Render) when you move this to a scheduled job:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./jobs.db

# Minimum cosine similarity (0-1) for a job to be flagged as "matched" against resume.txt
MATCH_THRESHOLD=0.15
